{
  "name": "pixel-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-sw.mjs",
    "build:site": "npm run build && node scripts/stage-site.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "serve": "npm run build && node scripts/serve.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
